# Database (SQLite by default for local dev; swap for Postgres in production)
DATABASE_URL="file:./dev.db"

# Session signing secret (generate a long random string)
SESSION_SECRET="change-me-to-a-long-random-string"

# WhatsApp Cloud API (Meta) - one set of these per business is stored in the
# Business table instead, but a default verify token is used at the webhook
# route level to complete Meta's handshake before a business is matched.
WHATSAPP_WEBHOOK_VERIFY_TOKEN="change-me"

# Optional: enables AI-personalized calling script generation via Claude.
# Leave unset to fall back to static Hinglish templates only.
ANTHROPIC_API_KEY=""

# Optional: voice-calling provider integration (e.g. Bland AI / Vapi / Exotel).
# Leave unset to keep calling scripts in "ready to trigger" (logged, not dialed) mode.
CALLING_PROVIDER_API_KEY=""
CALLING_PROVIDER_BASE_URL=""

# Optional: Resend (https://resend.com) for actually emailing password-reset
# links. Without these, a reset link is logged to SystemLog (/admin/logs)
# instead of emailed — a super admin can relay it manually.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS=""

# Base URL used to build links in emails (e.g. password reset). Falls back
# to the request's own origin if unset.
APP_URL=""

# Razorpay (https://razorpay.com) — required to accept real plan-upgrade
# payments. Without these, the Billing page still shows plans but the
# "Upgrade" button is disabled with an explanation instead of a fake
# checkout. RAZORPAY_KEY_ID is also readable by the browser (it's public by
# design — Razorpay's checkout needs it client-side); RAZORPAY_KEY_SECRET
# must stay server-only.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional: a Slack incoming-webhook URL (or any endpoint that accepts
# JSON) to receive real-time alerts for ERROR-level events. Without this,
# errors still land in SystemLog (/admin/logs) but nobody gets paged.
ALERT_WEBHOOK_URL=""

# Required to call POST /api/cron/downgrade-expired-plans (a scheduled
# sweep that downgrades lapsed plans back to STARTER — see README billing
# notes). Set this and configure your scheduler (e.g. Vercel Cron) to send
# it as `Authorization: Bearer <value>`. Without it, that route refuses to
# run rather than being an open, unauthenticated endpoint.
CRON_SECRET=""
