# Database (SQLite by default for local dev; swap for Postgres in production)
DATABASE_URL="file:./dev.db"

# Session signing secret (generate a long random string)
SESSION_SECRET="change-me-to-a-long-random-string"

# WhatsApp Cloud API (Meta) - one set of these per business is stored in the
# Business table instead, but a default verify token is used at the webhook
# route level to complete Meta's handshake before a business is matched.
WHATSAPP_WEBHOOK_VERIFY_TOKEN="change-me"

# Optional: enables AI-personalized calling script generation via Claude.
# Leave unset to fall back to static Hinglish templates only.
ANTHROPIC_API_KEY=""

# Optional: voice-calling provider integration (e.g. Bland AI / Vapi / Exotel).
# Leave unset to keep calling scripts in "ready to trigger" (logged, not dialed) mode.
CALLING_PROVIDER_API_KEY=""
CALLING_PROVIDER_BASE_URL=""

# Optional: Resend (https://resend.com) for actually emailing password-reset
# links. Without these, a reset link is logged to SystemLog (/admin/logs)
# instead of emailed — a super admin can relay it manually.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS=""

# Base URL used to build links in emails (e.g. password reset). Falls back
# to the request's own origin if unset.
APP_URL=""

# Razorpay (https://razorpay.com) — required to accept real plan-upgrade
# payments. Without these, the Billing page still shows plans but the
# "Upgrade" button is disabled with an explanation instead of a fake
# checkout. RAZORPAY_KEY_ID is also readable by the browser (it's public by
# design — Razorpay's checkout needs it client-side); RAZORPAY_KEY_SECRET
# must stay server-only.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional: a Slack incoming-webhook URL (or any endpoint that accepts
# JSON) to receive real-time alerts for ERROR-level events. Without this,
# errors still land in SystemLog (/admin/logs) but nobody gets paged.
ALERT_WEBHOOK_URL=""

# Required to call POST /api/cron/downgrade-expired-plans (a scheduled
# sweep that downgrades lapsed plans back to STARTER — see README billing
# notes). Set this and configure your scheduler (e.g. Vercel Cron) to send
# it as `Authorization: Bearer <value>`. Without it, that route refuses to
# run rather than being an open, unauthenticated endpoint.
CRON_SECRET=""

# ── SMS (Twilio) — WayneRing AI Front Desk ───────────────────
# Without these, SMS runs in dry-run mode: messages are saved as NOT_SENT
# (visible in the inbox) but nothing is texted. Also used to verify Twilio
# webhook signatures (X-Twilio-Signature) on /api/webhook/sms.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# APP_URL (above) must be set in production: Twilio signs the public URL,
# and delivery receipts go to APP_URL/api/webhook/sms/status.

# Optional: approved WhatsApp templates for customers who prefer WhatsApp.
# Body variables: {{1}} first name, {{2}} link. Unset = those customers get SMS.
WHATSAPP_TEMPLATE_WINBACK=""
WHATSAPP_TEMPLATE_REVIEW=""
WHATSAPP_TEMPLATE_LANG="en"

# ── AI Growth Manager (Bundle A brain) ───────────────────────
# Hourly cron: /api/cron/growth (vercel.json; needs a plan with hourly crons).
# Claude writes customer messages; without a key, templates are used.
# ANTHROPIC_API_KEY is shared with calling scripts (above).
GROWTH_MODEL="claude-haiku-4-5-20251001"
# Number the owner brief is texted from when a location has no texting number.
GROWTH_SMS_FROM=""
# WayneRing default URL (per business: Growth settings → WayneRing URL + wrcb_ key).
WAYNERING_API_URL=""
# GMB Manager service login (one internal account the brain uses).
GMB_API_URL=""
GMB_SERVICE_EMAIL=""
GMB_SERVICE_PASSWORD=""
# AI Video Studio service login.
VIDEO_STUDIO_API_URL=""
VIDEO_STUDIO_EMAIL=""
VIDEO_STUDIO_PASSWORD=""
# Optional WhatsApp template for follow-ups ({{1}} first name, {{2}} link).
WHATSAPP_TEMPLATE_FOLLOWUP=""

# ── One platform (Bundle A): Regulars is the hub ──────────────────────────
# Each tool shares ONE secret with the hub (32+ random characters, different
# per tool). Put the same value in that tool's HUB_SECRET.
#   openssl rand -hex 32
HUB_SECRET_WAYNERING=""
HUB_SECRET_FIELD_SERVICE=""
HUB_SECRET_GMB=""
HUB_SECRET_VIDEO=""
# Where the owner's browser is sent for single sign-on (the tools' web apps).
WAYNERING_APP_URL=""          # e.g. https://app.wayneringai.com (voce-flow-hub)
FIELD_SERVICE_APP_URL=""      # e.g. https://crm.wayneesolutions.com
GMB_APP_URL=""                # the Google profile app's address
VIDEO_STUDIO_APP_URL=""       # the Ad Studio app's address
FIELD_SERVICE_API_URL=""      # backend base URL, without /api/v1
# WAYNERING_API_URL, GMB_API_URL and VIDEO_STUDIO_API_URL above are reused.
